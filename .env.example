# Copy to .env and adjust. Never commit .env. Every variable is validated in src/lib/env.ts.

# Do not set NODE_ENV here: Next.js sets it (a shell-exported NODE_ENV=development breaks
# `next build`). APP_ENV says which deployment this is.
APP_ENV=development
# Tenants resolve as {slug}.ROOT_DOMAIN (e.g. lsetf.localhost:3000). lvh.me:3000 also works.
ROOT_DOMAIN=localhost:3000
LOG_LEVEL=info

# Two database connections (see docs/ARCHITECTURE.md, "Database roles"):
# - DATABASE_OWNER_URL: the owner/migrator. Only db:migrate, db:seed, db:reset and tests use it.
# - DATABASE_URL: the restricted runtime login (app_login) the app uses. Not a superuser,
#   owns nothing, and can only act through withTenant. db:migrate sets its password from
#   APP_DB_PASSWORD, which must match the password inside DATABASE_URL.
#
# Option A, Docker Compose (default): matches docker-compose.yml
DATABASE_OWNER_URL=postgres://innopower:innopower_dev@localhost:5432/innopower
APP_DB_PASSWORD=app_login_dev_password
DATABASE_URL=postgres://app_login:app_login_dev_password@localhost:5432/innopower
# Option B, hosted dev Postgres (Neon or Supabase): use direct (non-pooled) URLs with sslmode
# DATABASE_OWNER_URL=postgresql://OWNER:PASSWORD@HOST/DB?sslmode=require
# DATABASE_URL=postgresql://app_login:APP_DB_PASSWORD@HOST/DB?sslmode=require

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=innopower-dev
S3_ACCESS_KEY_ID=innopower
S3_SECRET_ACCESS_KEY=innopower_dev

# Mailpit locally (web UI at http://localhost:8025)
SMTP_URL=smtp://localhost:1025

# Demo seed is refused in production unless this is true.
ALLOW_DEMO_SEED=false
