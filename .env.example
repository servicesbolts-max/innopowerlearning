# Copy to .env and adjust. Never commit .env. Every variable is validated in src/lib/env.ts.

NODE_ENV=development
APP_ENV=development
# Tenants resolve as {slug}.ROOT_DOMAIN (e.g. lsetf.localhost:3000). lvh.me:3000 also works.
ROOT_DOMAIN=localhost:3000
LOG_LEVEL=info

# Option A, Docker Compose (default): matches docker-compose.yml
DATABASE_URL=postgres://innopower:innopower_dev@localhost:5432/innopower
# Option B, hosted dev Postgres (Neon or Supabase): use the direct (non-pooled) URL with sslmode
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=innopower-dev
S3_ACCESS_KEY_ID=innopower
S3_SECRET_ACCESS_KEY=innopower_dev

# Mailpit locally (web UI at http://localhost:8025)
SMTP_URL=smtp://localhost:1025

# Demo seed is refused in production unless this is true.
ALLOW_DEMO_SEED=false
